<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 (API 26 and 27): backups can't be required to be encrypted on these versions, so
     nothing is backed up. Android 9 to 11 use xml-v28/backup_rules.xml instead, and Android 12 and
     higher use data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
