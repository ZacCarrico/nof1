<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: only the database, in cloud backups only when they're end-to-end
     encrypted (the user has a screen lock), and in direct transfers to a new device. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
